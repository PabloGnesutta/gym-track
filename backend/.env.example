PORT=3033
SERVER_HOST="http://localhost:3033"
NODE_ENV=development

# Public base URL used to build the one-click link in password-reset emails
# (see src/lib/appUrl.js). Optional - falls back to http://localhost:PORT,
# which is only right for local dev; set this to the real deployed origin
# in production.
APP_BASE_URL=

# Email (see src/services/emailService.js) - all optional locally, but
# required for password-reset emails to actually send. sendEmail() logs and
# no-ops rather than throwing if these are missing.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_APP_NAME=GymTrack
